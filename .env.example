# Docker Compose example only. XAMPP does not load this file automatically.
# For native XAMPP, configure the upload/scanner variables in Apache's
# environment and point CLAMAV_HOST at a scanner reachable from the host.
# Do not disable scanning or expose the ClamAV port to the public internet.
NEXGEN_ENV=development
NEXGEN_FORCE_HTTPS=false
APP_PORT=8080
NEXGEN_DB_HOST=host.docker.internal
NEXGEN_DB_PORT=3306
NEXGEN_DB_NAME=replace_with_local_database_name
NEXGEN_DB_USER=replace_with_local_application_user
NEXGEN_DB_PASSWORD=
NEXGEN_PRIVATE_UPLOAD_DIR=/data/nexgen-private
NEXGEN_UPLOAD_QUARANTINE_DIR=/tmp/nexgen-upload-quarantine
NEXGEN_UPLOAD_ENCRYPTION_KEY=
NEXGEN_PYTHON_BIN=/opt/nexgen-upload-venv/bin/python
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8
NEXGEN_PUBLIC_UPLOAD_DIR=
NEXGEN_RESEND_API_KEY=
NEXGEN_RESEND_FROM_ADDRESS=
NEXGEN_RESEND_FROM_NAME=NexGen
